# CleanHouse Environment Configuration
# Copy this file to .env and modify as needed

# Access Control
CLEANHOUSE_MODE=developer_only
CLEANHOUSE_ALLOWED_DOMAINS=mycompany.com,dev.company.com
CLEANHOUSE_WHITELISTED_EMAILS=admin@mycompany.com,dev@mycompany.com
CLEANHOUSE_INVITE_TOKENS=dev-token-123,admin-token-456

# Database Configuration
# CLEANHOUSE_DB_PATH=/path/to/cleanhouse.db

# Files evidence travels through authenticated VVAULT routes. CleanHouse does
# not connect to a Wazuh indexer or manager administration surface directly.
# Secrets belong in the macOS Keychain or protected deployment environment.
# CLEANHOUSE_VVAULT_URL=https://vvault.thewreck.org
# CLEANHOUSE_WAZUH_EVENTS_URL=https://vvault.thewreck.org/api/cleanhouse/files/wazuh/events
# CLEANHOUSE_WAZUH_INVENTORY_URL=https://vvault.thewreck.org/api/cleanhouse/files/wazuh/inventory
# CLEANHOUSE_WAZUH_STATUS_URL=https://vvault.thewreck.org/api/cleanhouse/files/wazuh/status
# CLEANHOUSE_WAZUH_ENROLL_URL=https://vvault.thewreck.org/api/cleanhouse/files/wazuh/enroll
# CLEANHOUSE_WAZUH_INVENTORY_MAX_ENTRIES=10000
# CLEANHOUSE_WATCH_DIR=/path/to/monitored/scope

# Authenticated OVVAULTS preservation for normalized Files evidence.
# CLEANHOUSE_VVAULT_FILES_EVIDENCE_URL=https://vvault.thewreck.org/api/cleanhouse/files/evidence
# Normal operation reuses the owner-scoped CleanHouse pairing credential from
# macOS Keychain. These legacy service-token settings are fallback-only.
# CLEANHOUSE_VVAULT_SERVICE_TOKEN=
# CLEANHOUSE_VVAULT_USER_EMAIL=
# CLEANHOUSE_VVAULT_USER_ID=
# CLEANHOUSE_VVAULT_INSTANCE_ID=zen-001
# CLEANHOUSE_VVAULT_SHARD=shard_0000

# Product-native authentication
CLEANHOUSE_ENABLE_AUTH=1
CLEANHOUSE_REQUIRE_LOGIN=1
CLEANHOUSE_PUBLIC_ORIGIN=http://localhost:3333
# High-volume packet capture is opt-in so it cannot starve sign-in/readiness.
# CLEANHOUSE_NETWORK_COLLECTOR_AUTOSTART=1
# CLEANHOUSE_NETWORK_HISTORY_ENABLED=1
# FLASK_SECRET_KEY=provision-through-approved-secret-storage
# JWT_SECRET_KEY=provision-through-approved-secret-storage

# Optional: Production Database
# CLEANHOUSE_DB_TYPE=postgresql
# CLEANHOUSE_DB_HOST=localhost
# CLEANHOUSE_DB_PORT=5432
# CLEANHOUSE_DB_NAME=cleanhouse
# CLEANHOUSE_DB_USER=cleanhouse_user
# CLEANHOUSE_DB_PASSWORD=your_password_here

# OAuth Configuration (for desktop OAuth sign-in)
# Microsoft OAuth (Azure AD)
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret  # Optional, PKCE is used for security

# Apple OAuth (Sign in with Apple)
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_CLIENT_SECRET=your-apple-client-secret  # Required for Apple

# Google OAuth (the client secret is required by the current server exchange)
# CLEANHOUSE_GOOGLE_CLIENT_ID=your-google-client-id
# CLEANHOUSE_GOOGLE_CLIENT_SECRET=provision-through-approved-secret-storage
# CLEANHOUSE_GOOGLE_CALLBACK_URL=http://localhost:3333/api/auth/google/callback

# Account recovery delivery
# EMAIL_SERVICE=resend
# RESEND_API_KEY=provision-through-approved-secret-storage
# FROM_EMAIL=CleanHouse <accounts@example.com>
# SMTP fallback: EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret  # Required for GitHub

# Cloudflare Turnstile (required for official CleanHouse signup)
# TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
# CLEANHOUSE_TURNSTILE_REQUIRED=1

# MFA factor encryption (prefer macOS Keychain service
# com.life.cleanhouse.auth.mfa, account encryption-key; value is 32 random
# bytes encoded as 64 hexadecimal characters). Environment injection is an
# explicit development/isolated-runtime fallback only.
# CLEANHOUSE_MFA_ENCRYPTION_KEY=64-hex-characters
# CLEANHOUSE_MFA_ENCRYPTION_KEY_FILE=/Users/you/.cleanhouse/auth/mfa-encryption-key
# CLEANHOUSE_RESEND_API_KEY_FILE=/Users/you/.cleanhouse/auth/resend-api-key

# CleanHouse legal document versions shown during signup
# LEGAL_VERSION_CLEANHOUSE_TERMS=2025-11-09
# LEGAL_VERSION_CLEANHOUSE_PRIVACY=2025-11-09
# LEGAL_VERSION_CLEANHOUSE_EECCD=2025-11-09
