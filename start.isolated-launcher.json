        "operation_id": "cleanhouse.isolated.build.pycompile/v1",
        "command": ["cleanhouse_env/bin/python3", "-m", "py_compile", "backend/runtime_supervisor.py", "backend/server.py", "scripts/start_isolated_runtime.py"],
        "environment": {"PYTHONPYCACHEPREFIX": "START_BUILD_ROOT/pycache"},
        "fresh_artifact": "START_BUILD_ROOT/pycache",
        "timeout_seconds": 20,
        "max_output_bytes": 65536,
        "expected": {"exit_code": 0},
