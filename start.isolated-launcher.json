    "files": [
      "backend/api/cleanhouse.py",
      "backend/runtime_env.py",
      "backend/runtime_supervisor.py",
      "backend/server.py",
      "scripts/start_isolated_runtime.py"
      ,"tests/test_start_isolated_runtime.py"
    ]
  },
  "entry": {
    "executable": "cleanhouse_env/bin/python3",
    "argv": ["scripts/start_isolated_runtime.py"],
    "cwd": "."
  },
  "isolation": {
    "bootstrap_home": "HOME under START_TASK_ROOT",
    "state_root": "START_STATE_ROOT",
    "data_root": "START_DATA_ROOT",
    "auth_config": "START_AUTH_CONFIG",
    "ephemeral_credentials": "START_EPHEMERAL_CREDENTIALS",
    "no_canonical_storage": true,
    "no_launch_manager": true,
    "no_browser": true
  },
  "ownership": {
    "contract": "cleanhouse.start_isolation_evidence.v1",
    "invocation_nonce": {
      "input": "START_INVOCATION_NONCE",
      "minimum_length": 32,
      "response_path": "isolation.invocation_nonce",
      "binding": "hmac-sha256"
    },
    "direct_child_binding": {
      "supervisor_path": "start_isolation.supervisor.pid",
      "backend_parent_path": "start_isolation.backend.parent_pid",
      "predicate": "backend_parent_pid_equals_supervisor_pid"
    },
    "process_group_binding": {
      "supervisor_path": "start_isolation.supervisor.process_group_id",
      "backend_path": "start_isolation.backend.process_group_id",
      "predicate": "both_equal_start_owned_process_group"
    },
    "listener_binding": {
      "health_path": "/health",
      "readiness_path": "/cleanhouse/status?ready=1",
      "predicate": "nonce_generation_source_pid_and_boot_id_match"
    },
    "extinction_proof": {
      "authority": "start_adapter_only",
      "predicate": "captured_pids_absent_and_process_group_absent_and_listener_unreachable",
      "product_claim": "NOT_VERIFIED_WHILE_LIVE"
    }
  },
  "runtime": {
    "loopback_host": "127.0.0.1",
    "port": "START_PORT",
    "health": "/health",
    "readiness": "/cleanhouse/status?ready=1",
    "generation_path": "isolation.generation",
    "freshness_path": "isolation.observed_at",
    "binding_path": "isolation.binding.digest"
  },
  "verification": {
    "contract": "life-start-final-verification/v2",
    "version": "2.0.0",
    "lanes": [
      {
        "id": "build",
